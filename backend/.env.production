NODE_ENV=production
PORT=5000
API_URL=https://campusthreadv1.onrender.com
CLIENT_URL=https://campus-threadv1.vercel.app
FRONTEND_URL=https://campus-threadv1.vercel.app

MONGODB_URI=<YOUR_PRODUCTION_MONGODB_URI>
JWT_SECRET=<YOUR_PRODUCTION_JWT_SECRET>
JWT_EXPIRE=15m
REFRESH_TOKEN_SECRET=<YOUR_PRODUCTION_REFRESH_TOKEN_SECRET>
REFRESH_TOKEN_EXPIRE=7d

CLOUDINARY_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>

PAYSTACK_PUBLIC_KEY=<YOUR_PAYSTACK_PUBLIC_KEY>
PAYSTACK_SECRET_KEY=<YOUR_PAYSTACK_SECRET_KEY>

EMAIL_SERVICE=brevo
BREVO_API_KEY=<YOUR_BREVO_API_KEY>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
EMAIL_USER=<YOUR_EMAIL_USER>
EMAIL_PASSWORD=<YOUR_EMAIL_PASSWORD>
EMAIL_FROM=<YOUR_EMAIL_FROM>

REDIS_URL=<YOUR_REDIS_URL_OR_LEAVE_DISABLED>
REDIS_ENABLED=false
ALLOWED_ORIGINS=https://campus-threadv1.vercel.app
DNS_SERVERS=1.1.1.1,8.8.8.8
TOTP_WINDOW=2
TOTP_TIME_STEP=30
ADMIN_EMAIL=admin@campusthread.com
